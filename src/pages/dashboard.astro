---
import Layout from "../layouts/Layout.astro";
import Panel from "../components/Panel.astro";
import MetricPanel from "../components/MetricPanel.astro";

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
---

<Layout
  title="GitHub Support SLA Monitor — Ticket #4549142"
  description="Live SLA monitoring dashboard for GitHub support ticket #4549142. Real data, zero human responses."
>
  <main class="dash-page">
    <header class="dash-header">
      <div class="dash-header-left">
        <a class="back-link" href={`${base}/`}><span class="back-arrow">&larr;</span> BACK TO TIMER</a>
        <span class="header-sep" aria-hidden="true"></span>
        <span class="dash-name">GITHUB&nbsp;SUPPORT&nbsp;SLA&nbsp;MONITOR</span>
        <span class="ticket-chip">#4549142</span>
      </div>
      <div class="dash-header-right">
        <span class="status-badge status-badge-resolved"><span class="badge-dot badge-dot-green"></span>RESOLVED &mdash; UNLOCKED</span>
        <span class="live-clock" id="live-clock">--:--:--</span>
      </div>
    </header>

    <section class="metrics-row" aria-label="Key metrics">
      <MetricPanel label="TIME TO FIRST HUMAN" valueId="metric-response-wait" value="61d 01h" sub="FROM OPEN TO FIRST HUMAN REPLY" accent="red" stagger="1" danger />
      <MetricPanel label="ACCOUNT UNLOCKED" valueId="metric-unlocked" value="UNLOCKED" subId="metric-unlocked-sub" sub="RESOLVED --" accent="gold" stagger="2" valueClass="metric-value-green" />
      <MetricPanel label="SUPPORT COMMENTS" valueId="metric-comments" value="1" subId="metric-comments-sub" sub="1 HUMAN FROM SUPPORT" accent="gold" stagger="3" />
      <MetricPanel label="TICKET OPENED" valueId="metric-created" value="--" accent="gold" stagger="4" />
      <MetricPanel label="FIRST REPLY BY" valueId="metric-first-reply" value="--" accent="gold" stagger="5" />
      <MetricPanel label="CASE CLOSED" valueId="metric-closed" value="--" accent="gold" stagger="6" />
    </section>

    <section class="charts-grid" aria-label="Response analytics">
      <Panel title="RESPONSE RATE" meta="0%">
        <div class="gauge-wrap">
          <canvas id="chart-rate" aria-label="Human response rate gauge"></canvas>
          <div class="gauge-center"><span class="gauge-center-green" id="gauge-value">100%</span><small id="gauge-sub">1/1 HUMAN REPLIES</small></div>
        </div>
      </Panel>

      <Panel title="RESPONSE PERCENTILES" meta="SINGLE SAMPLE">
        <div class="chart-wrap">
          <canvas id="chart-percentiles" aria-label="Flat percentiles of time to human response"></canvas>
        </div>
      </Panel>

      <Panel title="RESPONSES PER DAY" meta="SINCE --" metaId="chart-since">
        <div class="chart-wrap">
          <canvas id="chart-per-day" aria-label="Replies per day since ticket creation"></canvas>
        </div>
      </Panel>

      <Panel title="CUMULATIVE WAIT" meta="LIVE">
        <div class="chart-wrap">
          <canvas id="chart-wait" aria-label="Cumulative days without human response"></canvas>
        </div>
      </Panel>
    </section>

    <aside class="dash-note">
      CASE NOTE &mdash; AFTER <b>61 DAYS</b> OF SILENCE ON A SUSPENSION APPEAL, AN AUTOMATED CHECK-IN ARRIVED ON
      <b>SEP 7</b>. THE AUTHOR CONFIRMED THE SAME EVENING, AND ON <b>SEP 8</b> A GITHUB ENGINEER CLEARED THE
      ACCOUNT RESTRICTIONS. THE CASE IS RESOLVED; ALL VALUES ON THIS PAGE ARE FROZEN AT THE MOMENT OF RESOLUTION.
    </aside>

    <section class="bottom-row" aria-label="Case details breakdown">
      <Panel title="COMMENTS LOG">
        <div class="panel-body">
          <div class="log-list" id="comments-log"></div>
        </div>
      </Panel>

      <Panel title="STATUS TIMELINE">
        <div class="panel-body">
          <div class="timeline-list" id="status-timeline"></div>
        </div>
      </Panel>

      <Panel title="CASE DETAILS">
        <div class="panel-body">
          <table class="details-table">
            <tbody>
              <tr><td class="details-key">TICKET</td><td class="details-value">#4549142</td></tr>
              <tr><td class="details-key">AUTHOR</td><td class="details-value">Ku6epXBOCTuK</td></tr>
              <tr><td class="details-key">CONTEXT</td><td class="details-value details-value-gold">FREE / UNSLAVED</td></tr>
              <tr><td class="details-key">RESOLVED BY</td><td class="details-value">GITHUB SUPPORT TEAM</td></tr>
              <tr><td class="details-key">UNLOCKED</td><td class="details-value details-value-green" id="details-unlocked">--</td></tr>
              <tr><td class="details-key">STATUS</td><td class="details-value details-value-green">RESOLVED / UNLOCKED</td></tr>
              <tr><td class="details-key">CREATED</td><td class="details-value" id="details-created">--</td></tr>
              <tr><td class="details-key">LAST COMMENT</td><td class="details-value" id="details-last-comment">--</td></tr>
            </tbody>
          </table>
        </div>
      </Panel>
    </section>

    <footer class="dash-footer">
      <div class="dash-footer-inner">
        <span>DATA SOURCE: ISSUE TRACKER</span>
        <span>TICKET #4549142</span>
        <span>LAST UPDATED: <span id="last-updated">--</span></span>
        <span>REFRESH: 60S</span>
      </div>
    </footer>
  </main>

  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>

  <script>
    import {
      AUTHOR,
      EVENTS,
      CREATED,
      RESOLVED_AT,
      LAST_EVENT,
      fmtClock,
      fmtStamp,
      fmtDate,
      fmtDaysHours,
    } from "../data/caseData";
    import { initCharts, updateCharts } from "../lib/dashboardCharts";

    const KIND_NAME: Record<string, string> = { system: "SYSTEM", author: AUTHOR, support: "GITHUB SUPPORT" };

    function renderLog(): void {
      const el = document.querySelector<HTMLElement>("#comments-log");
      if (!el) return;
      el.innerHTML = EVENTS.map((e) => {
        const cls = e.kind === "system" ? "log-author log-author-system" : e.kind === "support" ? "log-author log-author-support" : "log-author";
        const name = KIND_NAME[e.kind];
        return `<div class="log-line"><span class="log-time">[${fmtDate(e.at)}]</span><span class="${cls}">${name}</span><span class="log-text">${e.text}</span></div>`;
      }).join("");
    }

    function renderTimeline(): void {
      const el = document.querySelector<HTMLElement>("#status-timeline");
      if (!el) return;
      el.innerHTML =
        EVENTS.map((e) => {
          const dot = e.kind === "system" ? "timeline-dot timeline-dot-muted" : "timeline-dot";
          const name = KIND_NAME[e.kind];
          return `<div class="timeline-item"><span class="${dot}"></span><span class="timeline-date">${fmtDate(e.at)}</span><span class="timeline-label">${e.label} <span class="timeline-by">&middot; ${name}</span></span></div>`;
        }).join("") +
        `<div class="timeline-item"><span class="timeline-dot timeline-dot-green"></span><span class="timeline-date">${fmtDate(RESOLVED_AT)}</span><span class="timeline-label timeline-label-green">CASE CLOSED &middot; MONITOR FROZEN</span></div>`;
    }

    function updateMetrics(): void {
      const responseWait = document.querySelector<HTMLElement>("#metric-response-wait");
      if (responseWait) responseWait.textContent = fmtDaysHours(RESOLVED_AT.getTime(), CREATED.getTime());

      const unlockedSub = document.querySelector<HTMLElement>("#metric-unlocked-sub");
      if (unlockedSub) unlockedSub.textContent = `AT ${fmtDate(RESOLVED_AT)}`;

      const commentsSub = document.querySelector<HTMLElement>("#metric-comments-sub");
      if (commentsSub) commentsSub.textContent = `${EVENTS.filter((e) => e.kind === "support").length} HUMAN FROM SUPPORT`;

      const created = document.querySelector<HTMLElement>("#metric-created");
      if (created) created.textContent = fmtDate(CREATED);

      const firstReply = document.querySelector<HTMLElement>("#metric-first-reply");
      if (firstReply) firstReply.textContent = "GITHUB SUPPORT";

      const closed = document.querySelector<HTMLElement>("#metric-closed");
      if (closed) closed.textContent = "CLOSED";
    }

    function tick(): void {
      const clock = document.querySelector<HTMLElement>("#live-clock");
      if (clock) clock.textContent = fmtClock(new Date());
    }

    function refresh(): void {
      const updated = document.querySelector<HTMLElement>("#last-updated");
      if (updated) updated.textContent = fmtStamp(RESOLVED_AT);
      updateCharts(Date.now());
    }

    const detailsLastComment = document.querySelector<HTMLElement>("#details-last-comment");
    if (detailsLastComment) detailsLastComment.textContent = fmtDate(LAST_EVENT.at);

    const detailsUnlocked = document.querySelector<HTMLElement>("#details-unlocked");
    if (detailsUnlocked) detailsUnlocked.textContent = fmtDate(RESOLVED_AT);

    const detailsCreated = document.querySelector<HTMLElement>("#details-created");
    if (detailsCreated) detailsCreated.textContent = fmtDate(CREATED);

    const chartSince = document.querySelector<HTMLElement>("#chart-since");
    if (chartSince) chartSince.textContent = `SINCE ${fmtDate(CREATED)}`;

    renderLog();
    renderTimeline();
    updateMetrics();
    tick();

    const lastUpdated = document.querySelector<HTMLElement>("#last-updated");
    if (lastUpdated) lastUpdated.textContent = fmtStamp(RESOLVED_AT);

    initCharts();

    window.setInterval(tick, 1000);
    window.setInterval(refresh, 60000);
  </script>
</Layout>